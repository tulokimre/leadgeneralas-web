---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Leadgenerálás és automatizált B2B ügyfélszerzés | Tulok Imre',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. HERO BLOKK -->
  <Hero
    tagline="Kiszámítható B2B ügyfélszerzés és CRM-automatizálás"
    actions={[
      {
        variant: 'primary',
        text: 'Díjmentes konzultáció kérése',
        href: '#kapcsolat',
        icon: 'tabler:calendar-event',
      },
      { text: 'Hogyan dolgozunk?', href: '#metodika' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1600&q=80',
      alt: 'Automatizált leadgeneráló és CRM rendszer folyamatábra',
    }}
  >
    <Fragment slot="title">
      Építsünk egy olyan rendszert, ami <span class="text-accent dark:text-white">helyetted is dolgozik</span>.
    </Fragment>

    <Fragment slot="subtitle">
      Nem elég csak hirdetni és az „alacsonyan csüngő gyümölcsöket” leszedni. Kutatásra épülő leadgeneráló és
      automatizált utánkövető rendszert tervezek és építek fel neked, amely összehangolja a marketinget az
      értékesítéssel – és azokat is vevővé gondozza, akik ma még csak tájékozódnak.
    </Fragment>
  </Hero>

  <!-- 2. RÖVID ALAPELV KIEMELÉS -->
  <Note
    title="Alapelv:"
    description="Piackutatás + visszautasíthatatlan ajánlat + automatizált utánkövetés = alacsonyabb vevőszerzési költség."
  />

  <!-- 3. METODIKA (3 PILLÉR + RENDSZERELEMEK) -->
  <Features
    id="metodika"
    tagline="A 3 pilléres metodika"
    title="Miért nem működnek az átlagos kampányok?"
    subtitle="Ha ugyanazt mondod, mint a versenytársaid, a vevők kizárólag az ár alapján döntenek. Mi rendszerszinten építjük fel az ügyfélszerzést."
    items={[
      {
        title: '1. Alapos piackutatás és pozicionálás',
        description:
          'Megkeressük a céged valódi versenyelőnyét, elemezzük a konkurenciát és a vevői motivációkat, hogy pontosan arra az üzenetre reagáljanak, ami megkülönböztet.',
        icon: 'tabler:search',
      },
      {
        title: '2. Visszautasíthatatlan ajánlat',
        description:
          'A jó ajánlat nem árengedményt jelent, hanem pontos illeszkedést, dedikált landing oldalakat és kockázatcsökkentő garanciákat – így a hirdetések is olcsóbbak lesznek.',
        icon: 'tabler:diamond',
      },
      {
        title: '3. Automatizált utánkövetés (Lead Nurturing)',
        description:
          'Építünk egy folyamatot azoknak is, akik ma még nem állnak készen a vásárlásra. Így akkor is tőled vásárolnak, amikor megérnek a döntésre.',
        icon: 'tabler:route',
      },
      {
        title: 'Marketing és értékesítés összehangolása',
        description:
          'Nem hagyjuk, hogy az érdeklődők elvesszenek egy táblázatban: átlátható CRM-folyamatot és értesítéseket kap az értékesítői csapatod.',
        icon: 'tabler:arrows-join-2',
      },
      {
        title: 'Célzott B2B kampány-infrastruktúra',
        description:
          'A teljes folyamatot egy kézben tartom, a fizetett hirdetések kezelését pedig bevált, dedikált hirdetési szakértő partner végzi.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Mérhető megtérülés és átlátható költségek',
        description:
          'Minden lépésnél előre látod a szoftver-, hirdetési és kivitelezési költségeket, és pontosan mérjük, miből lesz valós bevétel.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- 4. CRM MINITRÉNING ÉS FELIRATKOZÁS -->
  <Content
    id="minitrening"
    isReversed
    tagline="Díjmentes tudásanyag"
    title="Mire jó nekem és cégemnek a CRM és a lead gondozás?"
    items={[
      {
        title: 'Érthető rendszerkép néhány rövid leckében',
        description:
          'A minitréning végére tisztán fogod látni, hogyan épül fel egy automatizált ügyfélszerző folyamat a gyakorlatban.',
      },
      {
        title: 'Döntéstámogatás cégvezetőknek és marketingeseknek',
        description:
          'Konkrét példákon keresztül el tudod dönteni, érdemes-e bevezetned a saját cégedben, és milyen eredményt várhatsz tőle.',
      },
      {
        title: 'Gyakorlati automatizálási tippek',
        description:
          'A minitréning után is csak olyan esettanulmányokat és ötleteket küldök, amelyeket azonnal hasznosítani tudsz.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1600&q=80',
      alt: 'CRM és e-mail automatizálási folyamat tervezése',
    }}
  >
    <Fragment slot="content">
      <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
        <h3 class="text-xl font-bold mb-2 dark:text-white">Beiratkozás a díjmentes minitréningre</h3>
        <p class="text-sm text-muted mb-4">
          Add meg az adataidat, és máris küldöm az első anyagot. Bármikor egy kattintással leiratkozhatsz.
        </p>

        {/* MEGJEGYZÉS: Az action="#" helyére kötjük be a hírlevélküldőd végpontját */}
        <form action="#" method="POST" class="space-y-3">
          <div>
            <label for="name" class="block text-xs font-medium mb-1">Keresztnév *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Pl. Gábor"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-transparent px-3 py-2 text-sm focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-medium mb-1">Üzleti e-mail cím *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="gabor@ceged.hu"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-transparent px-3 py-2 text-sm focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label for="role" class="block text-xs font-medium mb-1">Melyik jellemző rád leginkább? *</label>
            <select
              id="role"
              name="role"
              required
              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm focus:border-primary focus:outline-none"
            >
              <option value="">Válassz egyet...</option>
              <option value="cegvezeto">Cégvezető vagyok</option>
              <option value="marketinges">Marketinges vagyok egy cégnél</option>
              <option value="vallalkozo">Kis- / egyszemélyes vállalkozó vagyok</option>
            </select>
          </div>

          <div class="flex items-start gap-2 pt-1">
            <input type="checkbox" id="gdpr" name="gdpr" required class="mt-1 h-4 w-4 rounded border-slate-300" />
            <label for="gdpr" class="text-xs text-muted leading-normal">
              Az <a href="/privacy" class="underline hover:text-primary">Adatkezelési tájékoztatót</a> elolvastam és elfogadom.
            </label>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-secondary cursor-pointer"
          >
            Kérem a díjmentes minitréninget
          </button>
        </form>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/70 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 5. EGYÜTTMŰKÖDÉS FOLYAMATA ÉS ÁRAK -->
  <Steps
    id="folyamat"
    title="Hogyan indulunk el? Átlátható folyamat és árak"
    items={[
      {
        title: '1. lépés: Díjmentes konzultáció és előzetes felmérés <span class="text-sm font-semibold text-green-600">(0 Ft)</span>',
        description:
          'Átbeszéljük a céljaidat, készítünk egy rövid előkutatást, és egy online megbeszélésen megmutatjuk, milyen irányban érdemes elindulni.',
        icon: 'tabler:messages',
      },
      {
        title:
          '2. lépés: Részletes piackutatás és stratégia <span class="text-sm font-semibold text-primary">(Bruttó 49.000 Ft – 100%-ban levonható)</span>',
        description:
          'Elkészítjük a teljes termék-, versenytárs- és vevőelemzést, a javaslatot az ajánlatra, garanciákra és a kampány-infrastruktúrára. Ha velünk valósítod meg, a teljes díjat levonjuk az első számlából.',
        icon: 'tabler:file-analytics',
      },
      {
        title: '3. lépés: Rendszerépítés, indítás és üzemeltetés',
        description:
          'Felépítjük a landing oldalakat, a CRM-et és az e-mail automatizmusokat, majd elindítjuk a hirdetéseket. Megfelelő árrés és értékesítési háttér esetén jutalékos együttműködésre is van lehetőség.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Kiszámítható ügyfélszerző gépezet',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1000&q=80',
      alt: 'B2B stratégiai tervezés',
    }}
  />

  <!-- 6. GYAKORI KÉRDÉSEK (GYIK) -->
  <FAQs
    id="gyik"
    tagline="Gyakori kérdések"
    title="Amit az indulás előtt érdemes tudni"
    subtitle="Összegyűjtöttem a leggyakoribb kérdéseket a folyamattal, a költségekkel és az együttműködéssel kapcsolatban."
    schema
    items={[
      {
        title: 'Milyen cégeknek ideális ez a megoldás?',
        description:
          'Elsősorban olyan B2B szolgáltatóknak, tanácsadóknak és nagyobb értékű terméket vagy szolgáltatást értékesítő KKV-knak, ahol a vevő nem egy impulzus alapján dönt, hanem bizalomra, edukációra és szakmai utánkövetésre van szüksége.',
      },
      {
        title: 'Milyen szoftveres és hirdetési költségekkel kell számolni?',
        description:
          'A stratégiai fázisban (2. lépés) pontos költségtervet kapsz. A hirdetési keret közvetlenül a hirdetési rendszerekben (pl. Google, Meta, LinkedIn) kerül elköltésre, a CRM és hírlevélküldő szoftvereket pedig a céged méretéhez és meglévő eszközeihez igazítjuk.',
      },
      {
        title: 'Mi történik, ha a 49.000 Ft-os stratégia után mégsem velünk folytatod?',
        description:
          'A kutatási és stratégiai dokumentum a tiéd marad, szabadon felhasználhatod házon belül vagy más kivitelezővel. Ha viszont velünk építed fel a rendszert, a teljes bruttó 49.000 Ft-ot levonjuk az első kivitelezési számlából.',
      },
      {
        title: 'Mikor választható a jutalékos együttműködési modell?',
        description:
          'Ha a terméked vagy szolgáltatásod árrése ezt lehetővé teszi, és rendelkezel felkészült értékesítési háttérrel (aki a beérkező, előszűrt érdeklődőket lezárja), akkor fix díj helyett vagy mellett jutalékos konstrukcióban is dolgozhatunk.',
      },
    ]}
  />

  <!-- 7. KAPCSOLAT / KONZULTÁCIÓ KÉRÉS -->
  <CallToAction
    id="kapcsolat"
    actions={[
      {
        variant: 'primary',
        text: 'Díjmentes konzultációt kérek e-mailben',
        href: 'mailto:imre.tulok@gmail.com?subject=D%C3%ADjmentes%20leadgener%C3%A1l%C3%A1si%20konzult%C3%A1ci%C3%B3',
        icon: 'tabler:mail',
      },
      {
        text: 'Velnaxa szakmai oldal',
        href: 'https://velnaxa.hu',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Beszéljük át a céged ügyfélszerzését!</Fragment>

    <Fragment slot="subtitle">
      Kérj egy 30 perces, kötelezettségmentes online konzultációt. Előtte készítek egy rövid előfelmérést a
      piacodról, hogy konkrét javaslatokkal ülhessünk le beszélgetni.
    </Fragment>
  </CallToAction>
</Layout>
